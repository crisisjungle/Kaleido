# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== 风险对象契约 =====
# 新建模拟默认使用 V2 机制路径生成；仅在紧急回滚生成逻辑时临时设为 1。
# 该开关不会改写已有 V2 产物或历史 V1 结论。
RISK_OBJECT_CONTRACT_VERSION=2

# DeepSeek V4 示例：
# LLM_API_KEY=your_deepseek_api_key_here
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL_NAME=deepseek-v4-flash
# 可选：deepseek-v4-pro
# 可选：enabled / disabled / auto（auto 会兼容旧别名 deepseek-chat / deepseek-reasoner）
# DEEPSEEK_THINKING_MODE=disabled
# DEEPSEEK_REASONING_EFFORT=high

# 备用 LLM（当主接口失败、额度耗尽或临时不可用时自动重试）
# LLM_FALLBACK_API_KEY=your_backup_api_key_here
# LLM_FALLBACK_BASE_URL=https://api.deepseek.com
# LLM_FALLBACK_MODEL_NAME=deepseek-v4-flash

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== 前端发布开关 =====
# full: 本地/内测显示完整推演入口
# space_only: 线上只显示太空碰撞模拟入口，推演和历史路由仍保留
VITE_PUBLIC_LAUNCH_MODE=full
VITE_API_BASE_URL=

# ===== 地图空间数据源（可选）=====
# 公共 Overpass 只适合轻量查询；生产环境建议把受控/自托管实例放在最前面。
# 多个地址用逗号分隔，失败时会依次切换并尝试本地缓存。
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter
OVERPASS_QUERY_TIMEOUT_SECONDS=12
OVERPASS_HTTP_TIMEOUT_SECONDS=15
OVERPASS_MAXSIZE_BYTES=67108864
MAP_SOURCE_CACHE_TTL_SECONDS=604800
# WorldCover WMS 仅用于地图背景分类，不作为分析级栅格证据。
# 这些默认值与 ESA 当前数据访问页指向的 TiTiler WMS 契约保持一致。
WORLDCOVER_WMS_URL=https://titiler.terrascope.be/wms
WORLDCOVER_WMS_VERSION=1.3.0
WORLDCOVER_WMS_LAYER=esa-worldcover-map-10m-2021-v2_map
WORLDCOVER_WMS_TIME=2021-01-01
WORLDCOVER_WMS_TIMEOUT_SECONDS=10
WORLDCOVER_WMS_ATTEMPTS=1
